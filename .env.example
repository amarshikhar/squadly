# ==============================================================================
# Squadly · Environment Variables
# Copy to .env.local for local dev. Configure in Vercel dashboard for production.
# ==============================================================================

# ---- Auth (NextAuth.js v5) ---------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Set to your local URL in dev (http://localhost:3000) and prod URL in production
AUTH_URL=http://localhost:3000

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Apple Sign-In (https://developer.apple.com)
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# Discord OAuth (https://discord.com/developers/applications)
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# ---- Database (Supabase Postgres) -------------------------------------------
# Get from Supabase: Settings → Database → Connection string (transaction pooler)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres

# Direct connection (used for migrations only, not for app runtime)
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres

# ---- Supabase (Auth + Storage + Realtime) -----------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Razorpay (UPI / India primary gateway) ---------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Razorpay X (creator payouts to UPI / bank) -----------------------------
# Same keys can be used if your account has both Payments and Payouts enabled,
# OR generate dedicated RazorpayX API keys at x.razorpay.com → Settings → API
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
# Your Razorpay X virtual account number from which payouts are debited
RAZORPAYX_ACCOUNT_NUMBER=

# ---- Stripe Connect (international fallback + creator payouts) --------------
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx

# ---- Cloudflare R2 (media storage) ------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=squadly-media
R2_PUBLIC_URL=https://media.squadly.gg

# ---- Pusher (real-time bidding + goal updates) ------------------------------
PUSHER_APP_ID=
NEXT_PUBLIC_PUSHER_KEY=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_CLUSTER=ap2

# ---- Riot Games API (Valorant rank verification) ----------------------------
RIOT_API_KEY=

# ---- App config -------------------------------------------------------------
# Platform commission % charged on service payments
PLATFORM_COMMISSION_PCT=15

# Coin pricing: 1 INR = COIN_RATE coins (e.g. 0.7 = 70 coins per ₹100)
COIN_RATE=0.7

# Min coin top-up amount in INR
MIN_TOPUP_INR=100

# Feature flags (true/false)
FEATURE_LOBBY_PASS=false
FEATURE_SQUAD_GOALS=false
FEATURE_COIN_ECONOMY=false
